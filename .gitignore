# Root build trees and installed/generated outputs.
/build*/
/compile_commands.json
# Historical snapshot remains on disk; current source is tracked separately.
/history/
# Local tooling caches.
.cache/
__pycache__/
*.py[cod]

# Keep example datasets; ignore other downloaded archives.
/data/**/*.gz
!/data/intel-lab/intel.log.gz
!/data/intel-lab/intel.gfs.log.gz
/data/**/*.part

# Local SDK skill runs and maintainer feedback; never included by default.
/.roboframe/feedback/

# Untracked personal editor configuration; existing tracked files are not affected.
/.clangd
/.vscode/settings.json
