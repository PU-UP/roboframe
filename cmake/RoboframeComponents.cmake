# Source/package selection is a host build decision, never a component runtime concern.
function(roboframe_component directory package version)
    string(TOUPPER "${directory}" key)
    string(REPLACE "-" "_" key "${key}")
    set(option_name "ROBOFRAME_${key}_SOURCE")
    set(${option_name} "${ROBOFRAME_DEFAULT_SOURCE}" CACHE STRING "SOURCE or PACKAGE for ${directory}")
    set_property(CACHE ${option_name} PROPERTY STRINGS SOURCE PACKAGE)
    if(${option_name} STREQUAL "SOURCE")
        if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/components/${directory}/CMakeLists.txt")
            message(FATAL_ERROR "${directory}: SOURCE selected but component source is missing")
        endif()
        add_subdirectory("components/${directory}")
    elseif(${option_name} STREQUAL "PACKAGE")
        find_package(${package} ${version} CONFIG REQUIRED)
    else()
        message(FATAL_ERROR "${option_name} must be SOURCE or PACKAGE")
    endif()
endfunction()
