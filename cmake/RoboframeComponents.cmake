# Source/package selection is a host build decision, never a component runtime concern.
function(roboframe_component directory package)
    string(TOUPPER "${directory}" key)
    string(REPLACE "-" "_" key "${key}")
    set(option_name "ROBOFRAME_${key}_SOURCE")
    set(${option_name} "${ROBOFRAME_DEFAULT_SOURCE}" CACHE STRING "SOURCE or PACKAGE for ${directory}")
    set_property(CACHE ${option_name} PROPERTY STRINGS SOURCE PACKAGE)
    if(${option_name} STREQUAL "SOURCE")
        if(NOT EXISTS "${PROJECT_SOURCE_DIR}/components/${directory}/CMakeLists.txt")
            message(FATAL_ERROR "${directory}: SOURCE selected but component source is missing")
        endif()
        add_subdirectory("${PROJECT_SOURCE_DIR}/components/${directory}" "${PROJECT_BINARY_DIR}/components/${directory}")
    elseif(${option_name} STREQUAL "PACKAGE")
        find_package(${package} CONFIG REQUIRED)
    else()
        message(FATAL_ERROR "${option_name} must be SOURCE or PACKAGE")
    endif()
    get_target_property(built_sdk ${package}::component ROBOFRAME_BUILT_WITH_SDK)
    get_target_property(host_sdk Roboframe::sdk ROBOFRAME_SDK_VERSION)
    if(NOT built_sdk)
        message(FATAL_ERROR "${package}: legacy package without build metadata; rebuild with the selected SDK")
    endif()
    string(REGEX MATCH "^[0-9]+" built_major "${built_sdk}")
    string(REGEX MATCH "^[0-9]+" host_major "${host_sdk}")
    if(NOT built_major STREQUAL host_major OR host_sdk VERSION_LESS built_sdk)
        message(FATAL_ERROR "${package}: incompatible SDK ${built_sdk}, host ${host_sdk}")
    endif()
endfunction()
